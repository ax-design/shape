{
  "name": "@ax-design/shape",
  "version": "0.3.0",
  "description": "Rectangle-plus-decoration shapes of Axiom Design System, drawn the same way on SVG and Canvas.",
  "keywords": [
    "shape",
    "svg",
    "canvas",
    "border",
    "corner-shape"
  ],
  "homepage": "https://github.com/ax-design/shape#readme",
  "bugs": {
    "url": "https://github.com/ax-design/shape/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ax-design/shape.git"
  },
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "source": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/test-utils.ts",
    "!dist/test-utils.*"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "bun test",
    "prepublishOnly": "bun run build"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "@types/bun": "latest"
  }
}
